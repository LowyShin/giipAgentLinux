################################################################################
# ⚠️⚠️⚠️ WARNING: THIS IS A SAMPLE/TEMPLATE FILE ⚠️⚠️⚠️
#
# DO NOT use this file to diagnose production issues!
# DO NOT read values from this file in git repository!
# 
# This file in git repository is ONLY A TEMPLATE for new installations.
# The ACTUAL configuration file is deployed on each server at:
#   Linux: ~/giipAgent/giipAgent.cnf
#   
# To check REAL production values, SSH to the actual server:
#   ssh user@server "cat ~/giipAgent/giipAgent.cnf"
#
################################################################################

# You can find secret key and lssn from giip user portal (web UI)
sk="<your secret key>"

# If you have lssn, put below.
lssn="0"

# Agent execution interval (seconds)
# 60 = Check queue every 60 seconds
giipagentdelay="60"

# Git Branch for Agent Auto-Update (git-auto-sync.sh)
# If not specified, defaults to 'real' branch
# Common values: real, staging, dev, test
branch="real"

# ============================================================================
# Gateway Configuration - 100% AUTO-DETECTED FROM DB
# ============================================================================
# ⚠️ DO NOT add any gateway-related settings here!
# ⚠️ ALL gateway settings are managed in the database (tLSvr table)
# ⚠️ Configure ONLY via Web UI -> lsvrdetail page
#
# Auto-detected settings (NO manual configuration needed):
#   - gateway_mode        → from tLSvr.is_gateway
#   - server list         → from pApiGatewayRemoteServerListForAgentbySK
#   - heartbeat interval  → hardcoded in script (every cycle)
#   - ssh credentials     → from tLSvr.gateway_ssh_* columns
#
# See: docs/GATEWAY_CONFIG_PHILOSOPHY.md
# ============================================================================

# API v2 (Recommended) - PowerShell-based, faster and more stable
apiaddrv2="https://giipfaw.azurewebsites.net/api/giipApiSk2"

# API v1 (Legacy) - ASP Classic-based
apiaddr="https://giipasp.azurewebsites.net"

# ============================================================================
# Azure SQL Monitor metrics (OPTIONAL, giip-issue #921)
# ============================================================================
# Only needed if this CSN has an Azure SQL (PaaS) database registered in
# database-management (db_host like *.database.windows.net). Same keys/pattern
# as the azure_cost collector (see giipdb/docs/30_Specs/AZURE_COST_COLLECTOR_SPECIFICATION.md).
# If omitted, the agent falls back to an existing `az login` session if present,
# otherwise Azure metrics are reported as azure_status="login_required" (not an error).
# az_subscription="<subscription id>"
# az_client_id="<service principal app id>"
# az_client_secret="<service principal secret>"
# az_tenant_id="<azure ad tenant id>"
